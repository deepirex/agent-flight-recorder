.DS_Store
__pycache__/
*.pyc

# Drafts and the artifact source (article.html is the published, standalone copy)
x-article.md
linkedin-post.md
agent-flight-recorder.html

# Never publish the recorder's signing key
poc/.keys/

# Runs: publish the v5 evidence runs, the replay results, the brake run and the demo run, without the sandbox copies
# (each contains nested git repositories). Records, summaries, incidents and labels are kept.
poc/runs/*
!poc/runs/v5-scripted/
!poc/runs/v5-live/
!poc/runs/v3-brake/
!poc/runs/replay-v5.json
!poc/runs/replay-v5-report.json
!poc/runs/benchmark-cases.json
!poc/runs/benchmark-results.json
!poc/runs/benchmark-report.json
!poc/runs/panel-cache.json
!poc/runs/panel-report.json
!poc/runs/embed-meta.json
!poc/runs/demo/
poc/runs/**/world/
poc/runs/**/snapshots/
